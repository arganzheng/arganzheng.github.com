---
layout: null
permalink: /moments.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} · 随笔</title>
    <description>写不成文章的碎碎念：一张图、一句话、一首歌。</description>
    <link>{{ site.url }}{{ site.baseurl }}/moments/</link>
    <atom:link href="{{ "/moments.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml" />
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% for e in site.data.moments.entries limit:30 %}
      <item>
        <title>{{ e.text | truncate: 40 | xml_escape }}</title>
        <description>{{ e.html | xml_escape }}</description>
        <pubDate>{{ e.time | date_to_rfc822 }}</pubDate>
        <link>{{ e.url | prepend: site.baseurl | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ e.url | prepend: site.baseurl | prepend: site.url }}</guid>
        <category>moments</category>
      </item>
    {% endfor %}
  </channel>
</rss>
